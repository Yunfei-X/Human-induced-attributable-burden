        row  <- pop_large[pop_large$LocIDLarge == regions_new_cir[m], cols, drop = FALSE]
        py <- days / ifelse(leap_year(yrs), 366, 365)
        totpop[m] <- if (nrow(row)) sum(as.numeric(row[1, ]) * py, na.rm = TRUE) else NA
    }
    
    #ATTRIBUTABLE NUMBERS-----
