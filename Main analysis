
cause_index <- c( "All")

# SPECIFICATION OF THE EXPOSURE FUNCTION
varfun <- "ns"
varper <- c(10,75,90)
# SPECIFICATION OF THE LAG FUNCTION
lag <- 28
lagnk <- 2
# DEGREE OF FREEDOM FOR SEASONALITY
dfseas <- 5


# MODEL FORMULA
formula <- y~tmeancb+factor(dow)+factor(holiday)+ns(dot,df=dfseas*length(unique(year)))

# LOAD THE FUNCTION FOR COMPUTING THE ATTRIBUTABLE RISK MEASURES
source("attrdl.R")


coef_list<-vcov_list<-list()

  # OBJECTS TO STORE COEFFICIENTS AND VCOV
  coef <- matrix(NA,length(regions),length(varper)+1,
                   dimnames=list(regions))
  
  vcov <- vector("list",length(regions))
  names(vcov) <- regions
  for(i in seq(length(regions))){
    # PRINT
    cat(i,"")
    # EXTRACT THE DATA
    data <- dlist[[i]]
    data$y <- unlist(data[,cause_index[outcome]])
    
    # DEFINE THE CROSSBASIS
    argvar <- list(fun = varfun, knots = quantile(data$tmean, varper / 100, na.rm = TRUE))
    tmeancb <- crossbasis(data$tmean,lag=lag,argvar=argvar,
                     arglag=list(knots=logknots(lag,lagnk)))
    
    # RUN THE MODEL
    model <- glm(formula, data=data, family=quasipoisson, na.action="na.exclude")
    cen <- mean(data$tmean,na.rm=T)
    loc <- grepl('tmean',names(coef(model)))
    
    pred <- try(crosspred(tmeancb,
                          coef=coef(model),
                          vcov=vcov(model),
                          model.link='log',
                          cen=cen,by=0.1))
    if("try-error"%in% class(pred)) next
    cen <- pred$predvar[which.min(pred$allRRfit)]
    
    # REDUCTION TO OVERALL CUMULATIVE
    red <- crossreduce(tmeancb,
                          coef=coef(model),
                          vcov=vcov(model),
                          model.link='log',
                          cen=cen)
    coef[i,] <- coef(red)
    vcov[[i]] <- vcov(red)
  }
  coef_list[[cause_index[outcome]]]<-coef
  vcov_list[[cause_index[outcome]]]<-vcov





for (country in seq(country_index)) {
  cat(country,"\n")
  
  data <- dataset[dataset$ISO==country_index[country],]
  regions_cir <- as.character(unique(data$LocIDLarge))
  dlist_cir <- lapply(regions_cir,function(x) data[data$LocIDLarge==x,])
  names(dlist_cir) <- regions_cir
  
  predper <- c(0:2,2.5,3:97,97.5,98:100)
  set.seed(13041975)
  predvar <- rowMeans(sapply(dlist_cir[regions_cir],function(x) quantile(jitter(x$tmean),predper/100,na.rm=T)))
  
  argvar <- list(x=predvar,fun=varfun,
                   knots=predvar[paste(sprintf("%.1f", varper),"%",sep="")])
  bvar <- do.call(onebasis,argvar)
  
  
  ## LOAD FIRST STAGE DATA
  coef<-coef_list[[cause_index[outcome]]]
  vcov<-vcov_list[[cause_index[outcome]]]
  
  country_regions <- unique(dataset$LocIDLarge[dataset$ISO == country_index[country]])

  coef <- coef[regions%in%country_regions,]
  vcov <- vcov[regions%in%country_regions]
  
  ##
  include <- (1:nrow(coef))[!is.na(coef[,1])]
  
  coef <- coef[include,]
  vcov <- vcov[include]
  
  is_positive_definite <- function(mat) {
    eigenvalues <- eigen(mat)$values 
    all(eigenvalues > 0)
  }
  index<-sapply(vcov,is_positive_definite)
  
  coef <- coef[which(index==TRUE),]
  vcov <- vcov[which(index==TRUE)]
  regions_new_cir <- names(vcov)
  
  ## META
  mv <- mixmeta(coef~1,vcov)
  
  # OBTAIN BLUPS the best linear unbiased predictor
  blup <- blup.mixmeta(mv,vcov=T)
  
  # GENERATE THE MATRIX FOR STORING THE RESULTS
  minperccity <- mintempcity <- rep(NA,length(regions_new_cir))
  names(mintempcity) <- names(minperccity) <- regions_new_cir
    
  # calculate MMT
  for(k in seq(length(regions_new_cir))) {
        data <- dlist[[regions_new_cir[k]]]
        predvar <- quantile(data$tmean,1:99/100,na.rm=T)
        # REDEFINE THE FUNCTION USING ALL THE ARGUMENTS (BOUNDARY KNOTS INCLUDED)
        argvar <- list(x=predvar,fun=varfun,
                   knots=quantile(data$tmean,varper/100,na.rm=T),
                   Bound=range(data$tmean,na.rm=T))
        bvar <- do.call(onebasis,argvar)
        minperccity[k] <- (1:99)[which.min((bvar%*%blup[[k]]$blup))]
        mintempcity[k] <- quantile(data$tmean,minperccity[k]/100,na.rm=T)
  }
    
    # CREATE THE MATRIX TO STORE THE ATTRIBUTABLE DEATHS
    matsim <- matrix(NA,length(regions_new_cir),5,dimnames=list(regions_new_cir,c("glob","extreme cold","cold","extreme heat","heat")))
    # NUMBER OF SIMULATION RUNS FOR COMPUTING EMPIRICAL CI
    nsim <- 1000
    tothosp <- totpop <- c()
    # CREATE THE ARRAY TO STORE THE CI OF ATTRIBUTABLE DEATHS
    arraysim <- array(NA,dim=c(length(regions_new_cir),5,nsim),
                      dimnames=list(regions_new_cir,c("glob","extreme cold","cold","extreme heat","heat")))
    set.seed(1234)
    for(m in seq(regions_new_cir)){
        cat(m,"")
        data <- dlist[[regions_new_cir[m]]]
        
        # DERIVE THE CROSS-BASIS
        argvar <- list(x=data$tmean,fun=varfun,knots=quantile(data$tmean,
                                                          varper/100,na.rm=T))
        cb <- crossbasis(data$tmean,lag=lag,argvar=argvar,
                     arglag=list(knots=logknots(lag,lagnk)))
            
        ## calculate threshold
        predvar <- quantile(data$tmean,c(2.5,97.5)/100,na.rm=T)
        thr_ecold <- predvar["2.5%"]
        thr_ehot <- predvar["97.5%"]


        # COMPUTE THE ATTRIBUTABLE Hosp
        # NB: THE REDUCED COEFFICIENTS ARE USED HERE
        matsim[m,"glob"] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                   vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m])
        matsim[m,"extreme cold"] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                   vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m],
                                   range=c(-100,thr_ecold))
        matsim[m,"cold"] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                   vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m],
                                   range=c(-100,mintempcity[m]))
        matsim[m,"extreme heat"] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                   vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m],
                                   range=c(thr_ehot,100))
        matsim[m,"heat"] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                   vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m],
                                   range=c(mintempcity[m],100))
        
        
        # COMPUTE EMPIRICAL OCCURRENCES OF THE ATTRIBUTABLE DEATHS
        # USED TO DERIVE CONFIDENCE INTERVALS
        arraysim[m,"glob",] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                      vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m],sim=T,nsim=nsim)
        arraysim[m,"extreme cold",] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                      vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m],
                                      range=c(-100,thr_ecold),sim=T,nsim=nsim)
        arraysim[m,"cold",] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                      vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m],
                                      range=c(-100,mintempcity[m]),sim=T,nsim=nsim)
        arraysim[m,"extreme heat",] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                      vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m],
                                      range=c(thr_ehot,100),sim=T,nsim=nsim)
        arraysim[m,"heat",] <- attrdl(data$tmean,cb,data[[cause_index[outcome]]],coef=blup[[m]]$blup,
                                      vcov=blup[[m]]$vcov,type="an",dir="forw",cen=mintempcity[m],
                                      range=c(mintempcity[m],100),sim=T,nsim=nsim)
        
        tothosp[m] <- sum(data[[cause_index[outcome]]],na.rm=T)
    }
    
    #ATTRIBUTABLE NUMBERS-----
    # CITY-SPECIFIC
    ancity <- matsim
    ancitylow <- apply(arraysim,c(1,2),quantile,0.025, na.rm = TRUE)
    ancityhigh <- apply(arraysim,c(1,2),quantile,0.975, na.rm = TRUE)
    rownames(ancity) <- rownames(ancitylow) <- rownames(ancityhigh) <- regions_new_cir
    
    # TOTAL
    # NB: FIRST SUM THROUGH CITIES
    antot <- colSums(matsim)
    antotlow <- apply(apply(arraysim,c(2,3),sum),1,quantile,0.025)
    antothigh <- apply(apply(arraysim,c(2,3),sum),1,quantile,0.975)

    antot_values <- sprintf("%d (%d, %d)", round(antot), round(antotlow), round(antothigh))
    categories<-names(antot)
    antot_matrix <- matrix(antot_values, nrow = 1)
    colnames(antot_matrix) <- categories
    rownames(antot_matrix) <- country_index[country]
    antot_results<-rbind(antot_results,antot_matrix)
    
    # ATTRIBUTABLE FRACTION-------
    # all COUNTRY
    tothosptot <- sum(tothosp)
    # ATTRIBUTABLE FRACTIONS
    # CITY-SPECIFIC
    afcity <- ancity/tothosp*100
    afcitylow <- ancitylow/tothosp*100
    afcityhigh <- ancityhigh/tothosp*100
    
    
    # TOTAL
    aftot <- antot/tothosptot*100
    aftotlow <- antotlow/tothosptot*100
    aftothigh <- antothigh/tothosptot*100
    
    aftot_values <- sprintf("%.2f (%.2f, %.2f)", aftot, aftotlow, aftothigh)
    categories_af<-names(aftot)

    aftot_matrix <- matrix(aftot_values, nrow = 1)
    colnames(aftot_matrix) <- categories_af
    rownames(aftot_matrix) <- country_index[country]
    aftot_results<-rbind(aftot_results,aftot_matrix)

}

