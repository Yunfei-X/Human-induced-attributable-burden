cls <- function(m){
  m <- tolower(m)
  if (grepl("step size truncated due to divergence", m, fixed=TRUE)) "divergence_truncated"
  else if (grepl("glm.fit: algorithm did not converge", m, fixed=TRUE)) "glm_not_converge"
  else if (grepl("stopped at boundary value", m, fixed=TRUE)) "glm_boundary"
  else if (grepl("na/nan/inf in 'x'", m, fixed=TRUE)) "nonfinite_in_x"
  else if (grepl("contrasts can be applied only to factors with 2 or more levels", m, fixed=TRUE)) "contrasts_single_level"
  else "others"
}

for(outcome in 1:length(cause_index)){
  # outcome<-1
  # OBJECTS TO STORE COEFFICIENTS AND VCOV
  if (varfun == "bs") {
    coef <- matrix(NA,length(regions),length(varper)+vardegree,
                   dimnames=list(regions))
  } else {
    coef <- matrix(NA,length(regions),length(varper)+1,
                   dimnames=list(regions))
  }
  
  vcov <- vector("list",length(regions))
  names(vcov) <- regions
  for(i in seq(length(regions))){
    # PRINT
    cat(i,"")
    # EXTRACT THE DATA
    data <- dlist[[i]]
    data$y <- unlist(data[,cause_index[outcome]])
    
    # DEFINE THE CROSSBASIS
      if (varfun == "ns") {
      argvar <- list(fun = varfun, knots = quantile(data$tmean, varper / 100, na.rm = TRUE))
    } else {
      argvar <- list(fun = varfun, knots = quantile(data$tmean, varper / 100, na.rm = TRUE), degree = vardegree)
    }
    tmeancb <- crossbasis(data$tmean,lag=lag,argvar=argvar,
                     arglag=list(knots=logknots(lag,lagnk)))
    
    # argvar1 <- list(fun = varfun, knots = quantile(data$RH, varper / 100, na.rm = TRUE))
    # RHcb <- crossbasis(data$RH,lag=lag,argvar=argvar1,
                     # arglag=list(knots=logknots(lag,lagnk)))
    
    # RUN THE MODEL
    model <- withCallingHandlers(
    try(glm(formula, data=data, family=quasipoisson, na.action="na.exclude"), silent=TRUE),
      warning = function(w){
        issue_log <<- rbind(issue_log, data.frame(
         Disease=cause_index[outcome], i=i, region=regions[i], type="warning", msg=cls(conditionMessage(w))
        ))
        invokeRestart("muffleWarning")
      }
    )
    if (inherits(model, "try-error")){
      issue_log <- rbind(issue_log, data.frame(
        Disease=cause_index[outcome],i=i, region=regions[i], type="error", msg=cls(attr(model, "condition")$message)
      ))
      next
    }
    
    cen <- mean(data$tmean,na.rm=T)
    loc <- grepl('tmean',names(coef(model)))
    
    pred <- try(crosspred(tmeancb,
                          coef=coef(model)[loc],
                          vcov=vcov(model)[loc,loc],
                          model.link='log',
                          cen=cen,by=0.1))
    if("try-error"%in% class(pred)) next
    cen <- pred$predvar[which.min(pred$allRRfit)]
    
    # REDUCTION TO OVERALL CUMULATIVE
    red <- crossreduce(tmeancb,
                          coef=coef(model)[loc],
                          vcov=vcov(model)[loc,loc],
                          model.link='log',
                          cen=cen)
    coef[i,] <- coef(red)
    vcov[[i]] <- vcov(red)
  }
  coef_list[[cause_index[outcome]]]<-coef
  vcov_list[[cause_index[outcome]]]<-vcov
}
